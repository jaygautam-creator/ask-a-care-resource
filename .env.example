# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Any ONE provider is enough; the app falls back Gemini -> Groq -> Ollama.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Local Ollama (no key). Start with: ollama serve && ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
